{
    "name": "URL to Webhook",
    "version": "1.1",
    "manifest_version": 3,
    "description": "Sends current tab URL to your self-hosted MediaMarauder download server",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    }
}
